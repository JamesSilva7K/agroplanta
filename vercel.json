{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/credito",
      "destination": "/credito/index.html"
    },
    {
      "source": "/credito/(.*)",
      "destination": "/credito/$1"
    },
    {
      "source": "/consulta",
      "destination": "/consulta.html"
    },
    {
      "source": "/admin",
      "destination": "/admin/index.html"
    },
    {
      "source": "/api/config",
      "destination": "/api/config.json"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    }
  ]
}
