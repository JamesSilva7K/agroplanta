{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/r/whatsapp",
      "destination": "/api/whatsapp"
    },
    {
      "source": "/r/whatsapp/(.*)",
      "destination": "/api/whatsapp?$1"
    },
    {
      "source": "/api/r/whatsapp",
      "destination": "/api/whatsapp"
    },
    {
      "source": "/api/r/whatsapp/(.*)",
      "destination": "/api/whatsapp?$1"
    },
    {
      "source": "/api/admin/config",
      "destination": "/api/admin?route=config"
    },
    {
      "source": "/api/admin/upload",
      "destination": "/api/admin?route=upload"
    },
    {
      "source": "/api/admin/metrics/clear",
      "destination": "/api/admin?route=metrics-clear"
    },
    {
      "source": "/api/analytics/metrics",
      "destination": "/api/analytics"
    },
    {
      "source": "/api/track/event",
      "destination": "/api/track?type=event"
    },
    {
      "source": "/api/track/lead-step",
      "destination": "/api/track?type=lead-step"
    },
    {
      "source": "/api/messages/:key/reset",
      "destination": "/api/messages?key=:key&reset=true"
    },
    {
      "source": "/api/messages/:key",
      "destination": "/api/messages?key=:key"
    },
    {
      "source": "/api/simulations",
      "destination": "/api/simulate?simulations=true"
    },
    {
      "source": "/css/8b87ddb693cffeb08e0834cdcfddb169.css",
      "destination": "/credito/css/8b87ddb693cffeb08e0834cdcfddb169.css"
    },
    {
      "source": "/credito",
      "destination": "/credito/index.html"
    },
    {
      "source": "/credito/(.*)",
      "destination": "/credito/$1"
    },
    {
      "source": "/consulta",
      "destination": "/credito/index.html"
    },
    {
      "source": "/consulta.html",
      "destination": "/credito/index.html"
    },
    {
      "source": "/simulador",
      "destination": "/credito/index.html"
    },
    {
      "source": "/simulador.html",
      "destination": "/credito/index.html"
    },
    {
      "source": "/portal-auth",
      "destination": "/admin/index.html"
    },
    {
      "source": "/portal-auth/(.*)",
      "destination": "/admin/index.html"
    },
    {
      "source": "/admin",
      "destination": "/admin/index.html"
    },
    {
      "source": "/admin/admin.css",
      "destination": "/admin/admin.css"
    },
    {
      "source": "/admin/(.*\\.css)",
      "destination": "/admin/$1"
    },
    {
      "source": "/admin/(.*\\.js)",
      "destination": "/admin/$1"
    },
    {
      "source": "/admin/(.*\\.png|.*\\.jpg|.*\\.svg|.*\\.ico|.*\\.webp)",
      "destination": "/admin/$1"
    },
    {
      "source": "/admin/(.*)",
      "destination": "/admin/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/admin/admin.css",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/admin/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate"
        }
      ]
    }
  ],
  "functions": {
    "api/*.js": {
      "maxDuration": 30
    }
  }
}