# ==============================================================
# PLANTAE AGROCRÉDITO - CONFIGURAÇÃO DO SISTEMA & TELEGRAM BOT
# ==============================================================

# Porta do Servidor Web
PORT=3000

# Número Padrão de WhatsApp para Recebimento de Leads (com DDI e DDD, apenas números)
# Exemplo: 5511999999999 ou 5567999887766
DEFAULT_WHATSAPP_NUMBER=5511999999999

# Token do Bot do Telegram (obtido através do @BotFather no Telegram)
# Exemplo: 123456789:ABCdefGHIjklMNOpqrSTUvwxYZ
TELEGRAM_BOT_TOKEN=

# Chat ID do Administrador no Telegram para Recebimento de Alertas Instantâneos de Leads
# (Se deixado em branco, o bot associará automaticamente o primeiro usuário que enviar /start no Telegram)
TELEGRAM_ADMIN_CHAT_ID=
